<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.cosmicshooterioy">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"> <!-- Важно: тема без ActionBar -->

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ОБЯЗАТЕЛЬНО ДОБАВЬ ЭТИ СТРОКИ -->
        <activity android:name=".GameActivity" android:screenOrientation="portrait" />
        <activity android:name=".ShopActivity" />
        <activity android:name=".LeaderboardActivity" />

    </application>
</manifest>